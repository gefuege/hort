{
  "name": "hort-api",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-01",
  "build": { "command": "npm run build" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/"] },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hort.pm", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "CHALLENGE", "class_name": "Challenge" },
      { "name": "SHARE", "class_name": "Share" },
      { "name": "INVITATIONS", "class_name": "Invitations" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Account", "RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["Challenge"] },
    { "tag": "v3", "new_sqlite_classes": ["Share"] },
    { "tag": "v4", "new_sqlite_classes": ["Invitations"] }
  ]
}
