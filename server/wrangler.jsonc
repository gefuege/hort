{
  "name": "hort-api",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "hort.pm", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account", "RateLimiter"] }]
}
